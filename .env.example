PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/nazar.db
NODE_ENV=development
# Build-time public extension URLs; change BOTH and rebuild for HTTPS deployment.
NAZAR_API_URL=http://localhost:3001
NAZAR_WEB_URL=http://localhost:5173
# Production only: configure these privately in the separate Nazar Vercel project.
# DATABASE_URL=postgresql://... (pooled persistent Postgres; never local file on Vercel)
# DIRECT_URL=postgresql://... (direct connection used only by migrations)
# WEB_ORIGIN=https://<verified-nazar-project>.vercel.app
# NAZAR_PUBLIC_ORIGIN=https://<verified-nazar-project>.vercel.app
# NODE_ENV=production
# PRODUCTION_DATABASE_URL=postgresql://... (optional explicit data-transfer target)
# Optional server-only Nazar AI; otherwise labelled rules analysis is used.
# AI_GATEWAY_API_KEY=...
# NAZAR_AI_MODEL=provider/model-id
# Available models: https://ai-gateway.vercel.sh/v1/models
