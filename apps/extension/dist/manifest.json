{
  "manifest_version": 3,
  "name": "Nazar — внимание по твоим правилам",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Учебные сессии, бюджет сайтов и осознанные исключения.",
  "permissions": [
    "storage",
    "tabs",
    "history",
    "idle",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nazar"
  },
  "icons": {
    "128": "icon.png"
  }
}